# Copy to .env to override defaults; `make run` passes these to the app. Nothing here is required.
# The only server RecordStudio contacts is GitHub, to look for updates (Settings › Updates).

# Where recordings, exports and library.sqlite live. Default: ~/Movies/RecordStudio
RECORD_STUDIO_DIR=

# Only needed for WebM export (MP4 and HEVC are encoded by macOS). Default: /opt/homebrew/bin or /usr/local/bin
FFMPEG_PATH=
